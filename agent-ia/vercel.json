{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/connexion/:id/aller",
      "destination": "/api/connexion?l=:id&etape=aller"
    },
    {
      "source": "/connexion/:id/retour",
      "destination": "/api/connexion?l=:id&etape=retour"
    },
    {
      "source": "/connexion/:id",
      "destination": "/api/connexion?l=:id"
    }
  ]
}
