# Copier en .env.local (ignoré par git) et remplir.
# En production : Vercel → Settings → Environment Variables.

# --- Canal Telegram ---
# Token du bot, donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Secret partagé avec Telegram, posé par `npm run set-webhook`.
# Générer avec : openssl rand -hex 32
TELEGRAM_SECRET_TOKEN=
# Liste d'AMORÇAGE : les chat_id autorisés avant qu'aucune conciergerie
# n'existe en base. Ensuite, c'est la table `membres` qui fait foi.
# VIDE = personne n'entre. Obtenir le sien : npm run chat-id
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Modèle ---
# console.anthropic.com — workspace dédié, avec un plafond de dépense
ANTHROPIC_API_KEY=
# Plafond souple, en euros par jour. Le plafond DUR est celui du workspace.
BUDGET_JOUR_EUR=2

# --- Transcription des vocaux (facultatif) ---
# Sans cette clé, l'agent répond poliment qu'il ne traite pas encore l'audio.
OPENAI_API_KEY=

# --- Repull (annonces, réservations, calendriers, messages voyageurs) ---
# Clé API créée sur https://repull.dev/dashboard (format sk_live_xxx).
# Ne jamais la committer : ici on la laisse vide, en production elle vit dans
# les variables d'environnement Vercel.
REPULL_API_KEY=
# Secret de signature de l'abonnement webhook (format whsec_xxx), rendu UNE
# seule fois par Repull à la création de l'abonnement vers /api/repull-webhook.
# Sans lui, toutes les livraisons sont refusées.
REPULL_WEBHOOK_SECRET=
# URL publique du déploiement : sert aux liens de connexion et au retour de
# Repull Connect. Ex. https://agent-ia.example.vercel.app
APP_URL=

# --- Base de données ---
# Chaîne de connexion Postgres (Supabase, Neon…), mode transaction pooler.
# Sans elle, le stockage est en mémoire et tout est perdu à chaque
# redémarrage : inutilisable en serverless.
DATABASE_URL=

# --- Tâches planifiées ---
# Protège /api/cron. Générer avec : openssl rand -hex 32
CRON_SECRET=
