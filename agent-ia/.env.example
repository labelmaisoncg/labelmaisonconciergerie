# Copier en .env.local (ignoré par git) et remplir.
# En production : Vercel → Settings → Environment Variables.

# --- Étape 1 : indispensable ---
# Token du bot, donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Secret partagé avec Telegram, posé via `npm run set-webhook`.
# Générer avec : openssl rand -hex 32
TELEGRAM_SECRET_TOKEN=
# Whitelist des chat_id autorisés, séparés par des virgules.
# VIDE = personne n'est autorisé (fail closed). Obtenir le sien : npm run chat-id
TELEGRAM_ALLOWED_CHAT_IDS=
# console.anthropic.com
ANTHROPIC_API_KEY=

# --- Optionnel : transcription des messages vocaux ---
# Sans cette clé, l'agent répond poliment qu'il ne traite pas encore l'audio.
OPENAI_API_KEY=

# --- Étape 2 : données Channex ---
CHANNEX_API_KEY=

# --- Étape 3 : mémoire et planning ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
