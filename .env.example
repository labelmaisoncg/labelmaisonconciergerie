# Variables d'environnement du site et de l'ERP : les NOMS seulement, jamais de valeur.
# Les valeurs se posent dans Vercel → Settings → Environment Variables (Production et Preview),
# puis on redéploie. Le détail de chaque variable : docs/erp/README.md, « Variables d'environnement ».
# Copie locale : .env.local (ignoré par git).

# --- Espaces extérieurs (32 caractères au moins, ex. `openssl rand -base64 48`) ---
# Absentes : espace propriétaire, espace opérations et livret de séjour restent fermés.
PROPRIETAIRE_SECRET=
OPERATIONS_SECRET=
SEJOUR_SECRET=

# --- Connexion à l'ERP et au registre du linge ---
ERP_PASSWORD=
LINGE_PASSWORD=

# --- Synchronisation Airbnb / Booking.com (Repull) ---
REPULL_API_KEY=
REPULL_WORKSPACE_LM=
REPULL_WEBHOOK_SECRET_ERP=
CRON_SECRET=

# --- Agent IA de la messagerie et des avis ---
ANTHROPIC_API_KEY=

# --- E-mails (invitations, liens de connexion, formulaire du site) ---
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# --- Notifications de l'app (Web Push) : générées dans Paramètres → Application → Avancé ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Facultatives ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=
ORIGINES_APERCU=
